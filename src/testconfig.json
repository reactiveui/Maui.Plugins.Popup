{
    "platform": {
        "execution": {
            "parallel": false
        }
    },
    "codeCoverage": {
        "Configuration": {
            "Format": "cobertura",
            "CodeCoverage": {
            "SkipAutoProperties": false,
            "Attributes": {
                "Exclude": ["^System\\.CodeDom\\.Compiler\\.GeneratedCodeAttribute$"]
            },
            "Sources": {
                "Exclude": ["[/\\\\]obj[/\\\\].*\\.g\\.cs$"]
            },
                "ModulePaths": {
                "Include": ["ReactiveUI\\.Maui\\.Plugins\\.Popup\\.dll$"],
                    "Exclude": [
                        ".*Tests\\.dll$",
                        ".*TestRunner.*"
                    ]
                }
            }
        }
    }
}
