<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ReactiveUI.Maui" Version="26.0.1" />
    <PackageVersion Include="Mopups" Version="1.3.4" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Reactive.Testing" Version="7.0.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Mocks.Maui" Version="1.2.5" />

    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="TUnit.Core" Version="1.84.0" />
    <PackageVersion Include="Verify.TUnit" Version="32.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="stylecop.analyzers" Version="1.3.180" />
  </ItemGroup>
  <Choose>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
      <ItemGroup Condition="'$(UseMaui)' == 'true'">
        <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" />
      </ItemGroup>
    </When>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
      <ItemGroup Condition="'$(UseMaui)' == 'true'">
        <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" />
        <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.130" />
      </ItemGroup>
    </When>
  </Choose>
</Project>
